#!/usr/bin/env bash
# One command that runs every gate Auros has. Run it before you believe anything.
#
# The point of a single entry point is that a gate nobody runs is a gate that does not exist. CI runs
# exactly this script, so "it passes locally" and "it passes in CI" cannot drift apart.
set -uo pipefail
cd "$(dirname "$0")"

PASS=0; FAIL=0; SKIP=0
run () {
  local name="$1"; shift
  printf '\n\033[1m── %s ──\033[0m\n' "$name"
  if "$@"; then printf '\033[32m   PASS\033[0m  %s\n' "$name"; PASS=$((PASS+1));
  else printf '\033[31m   FAIL\033[0m  %s\n' "$name"; FAIL=$((FAIL+1)); fi
}
skip () { printf '\n\033[1m── %s ──\033[0m\n   \033[33mSKIP\033[0m  %s\n' "$1" "$2"; SKIP=$((SKIP+1)); }

# ── A public repo must not state a licence its LICENSE file contradicts ─────────────────────────────
run "licence consistency (README vs LICENSE)" node tools/licence-consistency.mjs

# ── §4.4 — no fabricated social proof, enforced mechanically ────────────────────────────────────────
# NOTE: the four product repos are separate git repos (DECISIONS.md D6) and are gitignored here, so a
# fresh checkout of the meta repo alone does not contain them. CI checks them out as siblings. If a
# directory is genuinely absent we SKIP — but the gate itself still fails closed on an empty scan, which
# is how we learned this: the first CI run reported FAIL rather than a false PASS.
if [ -d auros-web/src ]; then run "honesty gate (spec §4.4)" node tools/honesty-gate.mjs auros-web/src
else skip "honesty gate (spec §4.4)" "auros-web not checked out here"; fi

# ── The 2026-09-20 honesty audit, as permanent assertions ───────────────────────────────────────────
# Each fatal and major finding from that audit is one named test here. A finding fixed only in prose
# comes back the next time somebody rewrites the paragraph; a finding fixed as an assertion does not.
if [ -f tools/honesty-regressions.test.mjs ]; then
  run "honesty regressions (2026-09-20 audit)" node --test tools/honesty-regressions.test.mjs
else skip "honesty regressions" "tools/honesty-regressions.test.mjs not present yet"; fi

# ── A published command is a claim about a filesystem ───────────────────────────────────────────────
# The rebuild command on the website was wrong by one path component for weeks. honesty-gate reads
# prose and cannot see a filesystem; this reads the filesystem.
if [ -d auros-web/src/content ]; then run "published commands resolve (spec §1.3)" node tools/content-commands.mjs
else skip "published commands resolve (spec §1.3)" "auros-web not checked out here"; fi

# ── §4.3 — no untested image reaches a customer ─────────────────────────────────────────────────────
if [ -f tools/gate.test.mjs ]; then run "publish gate (spec §4.3)" node --test tools/gate.test.mjs
else skip "publish gate (spec §4.3)" "tools/gate.test.mjs not present yet"; fi

# ── §4.3 — the gate's refusal paths, and that nothing relaxes them ──────────────────────────────────
# The catalogue in gate.test.mjs, plus the shapes a ledger takes on a FILESYSTEM: line endings,
# padding, byte-identical duplication, symlinks, permissions. Also executes the claim in gate.mjs's
# header comment that no flag or environment variable turns a refusal into an allow.
if [ -f tools/gate.refusals.test.mjs ]; then
  run "publish gate refusals (spec §4.3)" node --test tools/gate.refusals.test.mjs
else skip "publish gate refusals (spec §4.3)" "tools/gate.refusals.test.mjs not present yet"; fi

# ── §4.4 — the honesty gate still works as a CLASSIFIER, not just on the sentences it has seen ──────
# ~45 real-looking marketing sentences, half of which must fire and half must not. The quiet half is
# the expensive one: a gate with false positives gets annotated past, and `auros-allow` reached for
# reflexively is the end of the gate. No degenerate implementation passes both halves.
if [ -f tools/honesty-gate.corpus.test.mjs ]; then
  run "honesty gate corpus (spec §4.4)" node --test tools/honesty-gate.corpus.test.mjs
else skip "honesty gate corpus (spec §4.4)" "tools/honesty-gate.corpus.test.mjs not present yet"; fi

# The two checks that read something other than the sentence: a cited workflow's own triggers, and
# whether CLAIMS.md has been re-read since the last decision. Both were added after a clean scan was
# reported over a false trust argument, and neither is in RULES, so the corpus above does not cover
# them.
if [ -f tools/honesty-gate.crossfile.test.mjs ]; then
  run "honesty gate cross-file checks (spec §4.4)" node --test tools/honesty-gate.crossfile.test.mjs
else skip "honesty gate cross-file checks (spec §4.4)" "tools/honesty-gate.crossfile.test.mjs not present yet"; fi

# ── The two state-file linters, proven able to go BOTH red and green ────────────────────────────────
# Running a linter over a clean file only ever proves the file is clean. These prove the linter can
# still say no — which is the half that stops being true silently.
if [ -f tools/compat-lint.test.mjs ]; then
  run "compat.tsv lint, both directions" node --test tools/compat-lint.test.mjs
else skip "compat.tsv lint, both directions" "tools/compat-lint.test.mjs not present yet"; fi

if [ -f tools/workflow-lint.test.mjs ]; then
  run "workflow lint, both directions" node --test tools/workflow-lint.test.mjs
else skip "workflow lint, both directions" "tools/workflow-lint.test.mjs not present yet"; fi

# ── §6B — a recipe may only ADD ─────────────────────────────────────────────────────────────────────
if [ -f auros-recipes/package.json ]; then
  run "recipe validator + compiler (spec §6B)" bash -euo pipefail -c 'cd auros-recipes && (pnpm test 2>&1 | tail -30)'
else skip "recipe toolchain (spec §6B)" "auros-recipes not scaffolded yet"; fi

# ── §6D — the order Worker, which is the only endpoint a stranger can reach ─────────────────────────
# 244 tests over Turnstile, the schema the Worker validates with, the YAML emitter, the signature on
# /build-result and the body of the pull request an order becomes. NOTHING RAN THEM. auros-web has
# exactly one workflow and it snapshots the build console; `pnpm build` runs the terrain and a11y
# tests and not these; this script did not mention the Worker at all. `worker/package.json`'s own
# `test` script could not have run them either -- `node --test test/` resolves `test/` as a MODULE
# path on Node 22 and dies with MODULE_NOT_FOUND before a single test executes, which is why nobody
# noticed. Among the tests that were unreachable: schema-provenance.test.js, the one that asserts
# the Worker validates against a schema byte-identical to the one auros-recipes uses in CI -- the
# assertion behind the sentence a refused visitor is shown at the moment they are most inclined to
# believe us. A suite nobody runs is a suite that does not exist.
if [ -f auros-web/worker/package.json ]; then
  run "order Worker (spec §6D)" bash -euo pipefail -c 'cd auros-web/worker && (node --test "test/*.test.js" 2>&1 | tail -20)'
else skip "order Worker (spec §6D)" "auros-web/worker not checked out here"; fi

# ── §6C — the abort path is tested more than the happy path ─────────────────────────────────────────
if command -v go >/dev/null 2>&1 && [ -f auros-installer/go.mod ]; then
  run "installer safety core (spec §6C)" bash -euo pipefail -c 'cd auros-installer && go vet ./... && go test ./... -count=1'
else skip "installer safety core (spec §6C)" "go not installed locally — this runs in CI"; fi

# ── CI workflows must actually parse, and must be able to fail ──────────────────────────────────────
run "workflow lint" node tools/workflow-lint.mjs auros-base auros-recipes auros-installer auros-web .

# ── Image hardening self-checks must be able to go BOTH red and green ───────────────────────────────
if [ -x auros-base/tests/kargs-check.test.sh ]; then
  run "hardening karg check (both directions)" auros-base/tests/kargs-check.test.sh
else skip "hardening karg check" "auros-base not checked out here"; fi

# Idioms wrong only on the HEALTHY path: grep -c's double zero (B8/B11 failed on every clean image)
# and find over absent directories dying silently under set -e.
if [ -x auros-base/tests/shell-idioms.test.sh ]; then
  run "shell idioms (healthy-path traps)" auros-base/tests/shell-idioms.test.sh
else skip "shell idioms" "auros-base not checked out here"; fi

# Three base builds were lost to systemd unit names from a version we do not run. This costs a second.
if [ -x auros-base/tests/units.test.sh ]; then
  run "systemd units + install-directive parse" auros-base/tests/units.test.sh
else skip "systemd units" "auros-base not checked out here"; fi

if [ -f auros-web/package.json ]; then
  run "site builds (spec §6D)" bash -euo pipefail -c 'cd auros-web && (pnpm build 2>&1 | tail -20)'
else skip "site build (spec §6D)" "auros-web not scaffolded yet"; fi

# ── §7 — the design system is fixed ─────────────────────────────────────────────────────────────────
# AFTER the build, and never before it. The tool measures the BUILT pages: it resolves the real
# cascade over the real DOM, and in that mode the custom properties come from the built CSS. Run
# against a stale dist/ it would report last build's tokens as a pass — so it now refuses to, and
# running it here rather than above is what keeps that refusal from being the normal outcome.
#
# The guard used to read `[ -f tools/contrast.mjs ]`, which is a path in THIS repo and has never
# existed: the tool lives in auros-web. So this line printed a skip on every run, locally and in CI,
# while claiming the §7 gate had been considered. Real coverage survived only because `pnpm build`
# happens to end in `verify:built`.
if [ -f auros-web/tools/contrast.mjs ]; then
  run "WCAG AA contrast, measured (spec §7)" bash -euo pipefail -c 'cd auros-web && node tools/contrast.mjs'
else skip "contrast (spec §7)" "auros-web/tools/contrast.mjs not present yet"; fi

# ── §7 — the build console shows real runs, and refuses to show anything else ───────────────────────
# Needs no network and no dist/: it reads the two committed snapshots and then breaks each property
# on purpose — an all-green record, a run with no link, a line stamped outside its own run — and
# asserts the thing responsible for noticing goes red. D37's lesson applied to the one element on
# the site whose whole argument is that it is true.
if [ -f auros-web/tools/build-console.test.mjs ]; then
  run "build console shows only real runs (spec §7)" bash -euo pipefail -c 'cd auros-web && node --test tools/build-console.test.mjs'
else skip "build console (spec §7)" "auros-web/tools/build-console.test.mjs not present yet"; fi

# ── §6D — the configurator's accessibility and honesty claims, as permanent assertions ──────────────
# The 2026-09-20 §7/a11y audit, one named test per fatal and major finding. Reads the BUILT pages,
# so it runs after the build for the same reason contrast does.
if [ -f auros-web/tools/configurator-a11y.test.mjs ]; then
  run "configurator a11y + honesty regressions (spec §6D)" bash -euo pipefail -c 'cd auros-web && node --test tools/configurator-a11y.test.mjs'
else skip "configurator a11y regressions (spec §6D)" "auros-web/tools/configurator-a11y.test.mjs not present yet"; fi

# The terrain's own §7 properties — the 18-colour ceiling measured against the real output buffer,
# the ore budget, the fixed seed, Math.random being unreachable, window-crop determinism. This file
# existed for a while as 493 lines that NOTHING ran: not package.json, not a workflow, not this
# script — and it could not be run, because its relative imports carried no extension. Both halves
# are fixed; this line is the half that makes it a gate. See the first line of this file.
if [ -f auros-web/src/terrain/terrain.test.ts ]; then
  run "terrain invariants (spec §7)" bash -euo pipefail -c 'cd auros-web && node --experimental-strip-types --test src/terrain/terrain.test.ts'
else skip "terrain invariants (spec §7)" "auros-web/src/terrain/terrain.test.ts not present yet"; fi

# ── The honesty check on our own state files ────────────────────────────────────────────────────────
run "compat.tsv honesty (no vm row claims a physical column)" node tools/compat-lint.mjs

# ── §8 — the two tools that put rows INTO compat.tsv and take answers back OUT of it ────────────────
# compat-lint guards the file. These guard the two things that touch it, and they are where the
# damage would actually be done: a capture tool that fills `wifi` from a loaded module writes a
# fabricated row, and a quote tool that reads an empty cell as a pass sells a school a laptop nobody
# tested. Both suites are paired — every refusal has a control that must still be accepted — and the
# capture suite MUTATES the shipping script to watch its guard fire.
#
# COST, measured rather than guessed: the capture suite is ~47 s of CPU but **3m47s of wall clock on
# macOS**, because it is ~2,500 short-lived processes and this laptop spends most of that in process
# creation (20% CPU utilisation for the whole run). On a Linux runner, where spawning is roughly two
# orders of magnitude cheaper, it is seconds. Recorded here so that a slow local `./verify` is read
# as what it is and not as something hanging.
if [ -x auros-base/tests/capture-compat.test.sh ]; then
  run "compat capture leaves the human columns empty (spec §8)" auros-base/tests/capture-compat.test.sh
else skip "compat capture (spec §8)" "auros-base not checked out here"; fi

if [ -f auros-base/tools/quote-from-compat.test.mjs ]; then
  run "compat quoting refuses vm rows and empty cells (spec §8)" node --test auros-base/tools/quote-from-compat.test.mjs
else skip "compat quoting (spec §8)" "auros-base not checked out here"; fi

# ── THE AGGREGATE ITSELF ────────────────────────────────────────────────────────────────────────────
# Everything above is theatre if THIS script can report success while one of them failed, and that
# has happened here: two gates were invoked as `bash -c '… | tail -20'`, and because `bash -c` starts
# a shell that does not inherit pipefail, a failing site build and a failing recipe suite both
# printed PASS. This runs the real ./verify inside sandboxes with one gate broken at a time and
# asserts the failure reaches the exit status. It runs LAST because it is the slowest, and it does
# not recurse: its sandboxes do not contain this file, so verify skips it there.
if [ -f tools/verify-meta.test.mjs ]; then
  run "verify propagates every failure (meta)" node --test tools/verify-meta.test.mjs
else skip "verify propagates every failure (meta)" "tools/verify-meta.test.mjs not present yet"; fi

printf '\n\033[1m════ %d passed · %d failed · %d skipped ════\033[0m\n' "$PASS" "$FAIL" "$SKIP"
[ "$FAIL" -eq 0 ] || exit 1
